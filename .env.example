# .env.example — шаблон переменных окружения для адаптации под Центральную Россию
# Скопируйте в .env и заполните реальными значениями. .env добавлен в .gitignore.

# --- OTA ---
# URL для проверки обновлений прошивки (замена https://api.tenclass.net/xiaozhi/ota/)
OTA_URL=https://ota.xiaozhi.ru/xiaozhi/ota/

# --- MQTT ---
# Конечная точка MQTT-брокера (замена китайского сервера)
MQTT_ENDPOINT=mqtt.xiaozhi.ru
MQTT_PORT=8883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_PUBLISH_TOPIC=

# --- WebSocket ---
# Конечная точка WebSocket-сервера
WEBSOCKET_ENDPOINT=wss://ws.xiaozhi.ru

# --- Поддержка ---
# Email для поддержки (замена xiaozhi.ai@tenclass.com)
SUPPORT_EMAIL=support@xiaozhi.ru
# Сайт поддержки (замена xiaozhi.me)
SUPPORT_WEBSITE=https://xiaozhi.ru

# --- Ассеты ---
# URL генератора кастомных ассетов (замена github.com/78/xiaozhi-assets-generator)
ASSETS_GENERATOR_URL=https://assets.xiaozhi.ru

# --- ГОСТ криптография ---
# Включить поддержку ГОСТ 2012 (ТК 26) для TLS и подписи OTA
USE_GOST_CRYPTO=0
# Публичный ключ для проверки подписи OTA (ГОСТ Р 34.10-2012)
OTA_SIGNATURE_PUBKEY=
# Путь к CA-сертификату для проверки TLS (ГОСТ)
GOST_CA_CERT=